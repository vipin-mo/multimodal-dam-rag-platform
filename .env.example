# Copy to .env and fill in, or run ./scripts/init-env.sh to generate random secrets.
# Values are interpolated into URLs: use URL-safe characters (letters, digits, - and _).
# Never commit .env.

# ---- Required secrets ------------------------------------------------------------
JWT_SECRET=                 # >= 32 chars, e.g. `openssl rand -hex 32`
POSTGRES_PASSWORD=
MINIO_ROOT_USER=dam-admin
MINIO_ROOT_PASSWORD=        # >= 8 chars
RABBITMQ_USER=dam
RABBITMQ_PASSWORD=
REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=     # only used with --profile monitoring

# ---- Seeded accounts (created on first start only; change later with
#      `docker compose exec api-gateway python -m app.database create-user <name> --role admin`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=             # >= 8 chars
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=            # leave empty to skip creating a viewer account

# ---- Network ----------------------------------------------------------------------
DAM_BIND=127.0.0.1                          # host interface for UI/API/MinIO ports
MINIO_PUBLIC_ENDPOINT=http://localhost:9000 # address browsers use for presigned media URLs
CORS_ORIGINS=http://localhost:8501

# ---- Models -----------------------------------------------------------------------
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_VISION_MODEL=llava:7b    # smaller alternative: moondream
WHISPER_MODEL_SIZE=tiny         # tiny | base | small | medium (slower, more accurate)
CAPTION_IMAGES=true             # describe images with the vision model at ingest

# ---- Ingestion & limits -----------------------------------------------------------
CHUNK_SIZE_CHARS=500
CHUNK_OVERLAP_CHARS=100
FRAME_SAMPLE_SECONDS=2
WORKER_CONCURRENCY=2
WORKER_THREADS=4
MAX_UPLOAD_MB=200               # UI / multipart API uploads
MAX_DIRECT_UPLOAD_MB=5120       # presigned direct uploads (scripts/dam_upload.py)
